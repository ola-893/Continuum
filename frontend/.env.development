# Development Environment Configuration
# This file is used when running the app in development mode (npm run dev)

# Use Ghostnet for development
VITE_TEZOS_NETWORK=ghostnet

# Ghostnet Contract Addresses (development deployment)
VITE_GHOSTNET_STREAMING_PROTOCOL=
VITE_GHOSTNET_ASSET_YIELD_PROTOCOL=
VITE_GHOSTNET_COMPLIANCE_GUARD=
VITE_GHOSTNET_TOKEN_REGISTRY=
VITE_GHOSTNET_RWA_HUB=
VITE_GHOSTNET_FA2_TOKEN=

# Development-specific settings
VITE_ENVIRONMENT=development
VITE_ENABLE_DEBUG=true

# Optional: Use local RPC node if available
# VITE_GHOSTNET_RPC=http://localhost:8732
